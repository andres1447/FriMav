<?xml version="1.0" encoding="utf-8" ?>
<EscCommandTemplate>
  <Line>48</Line>
  <NewLine/>
  <NewLine>
    <Right>
      <Text>@Model.Date.ToString("dd/MM/yyyy HH:mm")</Text>
    </Right>
  </NewLine>
  <NewLine/>
  <NewLine>
    <Center>
	<Text Size="2">@Model.CustomerCode - @Model.CustomerName</Text>
    </Center>
  </NewLine>
    <NewLine>
        <Center>
            <Text Size="2">Pedido</Text>
        </Center>
    </NewLine>
  <NewLine/>
  <Line>48</Line>
  <NewLine/>
@foreach (var item in Model.Items)
{
	<NewLine>
		<Text Width="20" Align="L">@item.Product</Text>
		<Text Width="10" Align="L">@item.Quantity.ToString("N2") @item.Measure.ToUpper()</Text>
	</NewLine>
	<NewLine/>
  }
  <Line>48</Line>
  <Feed>9</Feed>
  <CutFull></CutFull>
</EscCommandTemplate>
